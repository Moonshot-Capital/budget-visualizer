{
  "name": "budget-visualizer",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "description": "Budget Visualizer – sieh, wohin dein Geld geht. Offline-fähige Web-App ohne Konto und ohne Backend.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "build:pages": "tsc --noEmit && vite build --outDir docs --emptyOutDir"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "framer-motion": "^13.2.0",
    "jspdf": "2.5.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
